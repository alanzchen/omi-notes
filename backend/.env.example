# omi-notes backend configuration. Copy to backend/.env (or export the variables).
# Environment variables win over this file. OMI_NOTES_ENV_FILE=/path/to/file selects another file.

# --- Server -------------------------------------------------------------------------------------
# Bearer token the iPhone app sends. `omi-notes pair` generates one here if it is empty.
OMI_NOTES_TOKEN=
# Bind address and port. Keep 127.0.0.1 and expose it with `tailscale serve` (HTTPS, tailnet only).
HOST=127.0.0.1
PORT=8765

# --- Vault ---------------------------------------------------------------------------------------
# The one folder with everything permanent: your Markdown notes plus `_omi/` (uploaded audio,
# conversation records, transcripts, summaries, voiceprints). Copy it anywhere and point a backend
# at it; the index is rebuilt from it (docs/vault.md). It can be (or live inside) an Obsidian vault.
VAULT_DIR=~/Documents/OmiNotes
# Disposable SQLite index + logs. Default: ~/Library/Application Support/omi-notes/index/<vault>/
# (never put it inside a synced folder). Delete it any time; it is rebuilt.
# INDEX_DIR=
# Host locks (one server/worker per vault on this Mac). Default: next to the index root.
# LOCK_DIR=
# IANA timezone used for filenames, daily notes and times in notes (default: this Mac's zone).
# TIMEZONE=America/Chicago
# Your name, so action items you own read "Alan" instead of "me". Optional.
OWNER_NAME=

# --- Speech to text -----------------------------------------------------------------------------
# deepgram | openai (any OpenAI-compatible /audio/transcriptions server) | fake (placeholder text)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
# Spoken language (e.g. en, de, es; "multi" = auto-detect).
STT_LANGUAGE=en
# Comma-separated names/terms to boost (people, products, places). At most 100 are sent.
STT_KEYTERMS=Omi

# OpenAI-compatible transcription (STT_PROVIDER=openai). Notes need speaker labels: pick a model
# that diarizes, or install local diarization (below). Examples:
#   Mistral (diarizes, 3 h per request):  STT_BASE_URL=https://api.mistral.ai/v1      STT_MODEL=voxtral-mini-latest
#   OpenAI (diarizes, split at 20 min):   STT_BASE_URL=https://api.openai.com/v1      STT_MODEL=gpt-4o-transcribe-diarize
#   Text-only GPT (local labels):        STT_MODEL=gpt-transcribe  STT_REQUEST_STYLE=json
#                                         STT_DIARIZATION=local  STT_MAX_REQUEST_SECONDS=30
#   Together (diarizes):                  STT_BASE_URL=https://api.together.xyz/v1    STT_MODEL=openai/whisper-large-v3
#   vLLM, self-hosted (diarizes):         STT_BASE_URL=http://gpu-box:8000/v1         STT_MODEL=OpenMOSS-Team/MOSS-Transcribe-Diarize
#   mlx-audio on a Mac (diarizes):        STT_BASE_URL=http://127.0.0.1:8000/v1       STT_MODEL=OpenMOSS-Team/MOSS-Transcribe-Diarize
#                                         STT_REQUEST_STYLE=verbose   (mlx-audio answers verbose_json)
#   LocalAI (diarize=true, backend-dependent) or whisper.cpp server (no mono diarization):
#                                         STT_BASE_URL=http://127.0.0.1:8080/v1       STT_MODEL=whisper-1
#                                         + local diarization
STT_BASE_URL=https://api.openai.com/v1
# Bearer token; leave empty for local servers that need none.
STT_API_KEY=
# auto (from the host/model) | openai_diarized | mistral | together | verbose | json
# json requires local diarization: each speaker window is transcribed separately; times are coarse.
STT_REQUEST_STYLE=auto
# Longest audio per request, seconds (unset = the service's known limit, 0 = unlimited). Longer audio
# is split between speech blocks and the pieces are merged.
# STT_MAX_REQUEST_SECONDS=

# --- Speaker labels -----------------------------------------------------------------------------
# auto: the provider's labels when one request covered the whole conversation, otherwise local
#       diarization if installed (consistent speakers across split audio)
# provider | local | off (off accepts transcripts without speaker labels)
STT_DIARIZATION=auto
# Local diarization runs sherpa-onnx on this machine (no torch):
#   uv sync --extra diarization && uv run omi-notes fetch-models --diarization
# 0 = decide the number of speakers from the threshold (smaller threshold = more speakers).
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_THRESHOLD=0.5

# --- Summaries ----------------------------------------------------------------------------------
# anthropic | openai | fake | none
#   openai = any OpenAI-compatible chat completions API: OpenAI, Ollama, llama.cpp, LM Studio, vLLM,
#            OpenRouter ... (set LLM_BASE_URL and LLM_MODEL; LLM_API_KEY if the server needs one)
#   none   = transcript-only notes, no LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Anthropic only. low | medium | high | xhigh | max: higher is more thorough and costs more;
# none omits it. Haiku models never get it (they reject the parameter).
LLM_EFFORT=medium
# OpenAI-compatible only. Examples: https://api.openai.com/v1 · http://localhost:11434/v1 (Ollama)
# · http://localhost:8080/v1 (llama.cpp) · http://localhost:1234/v1 (LM Studio) · http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# auto tries a strict JSON schema, then JSON mode, then prompt-only (remembered per run).
LLM_JSON_MODE=auto
# Optional `reasoning_effort` for reasoning models (e.g. low | medium | high); empty = not sent.
LLM_REASONING_EFFORT=

# --- Conversation segmentation (seconds) --------------------------------------------------------
# A silence at least this long ends a conversation.
CONVERSATION_GAP_SECONDS=120
# If the audio needed to confirm an ending has not arrived, close anyway (marked provisional)
# this long after the gap: short wait while the phone is connected, longer otherwise.
PROVISIONAL_WAIT_OPEN_SECONDS=300
PROVISIONAL_WAIT_SECONDS=1200
# Long conversations: split at the next 20 s pause after the soft cap, or hard at the hard cap.
SOFT_MAX_CONVERSATION_SECONDS=10800
HARD_MAX_CONVERSATION_SECONDS=11400

# --- Audio --------------------------------------------------------------------------------------
# silero (default; run `omi-notes fetch-models`) | energy (crude fallback)
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
# Uploaded raw audio is deleted this many days after every conversation using it is finished.
RAW_RETENTION_DAYS=30
# How often the worker looks for new work.
WORKER_TICK_SECONDS=5

# --- Speaker recognition (docs/speaker-learning.md) --------------------------------------------
# Inert until you enroll your voice or name someone in the app. Needs the optional extra and model:
#   uv sync --extra diarization && uv run omi-notes fetch-models --speakers
# SPEAKER_MODEL=models/wespeaker_en_voxceleb_resnet34_LM.onnx
# Name people automatically once they pass the activation gate (≥3 confirmations on ≥2 days).
SPEAKER_AUTO_ASSIGN=true
# Operating points (priors from Omi's pendant measurements); `omi-notes speakers bench` suggests
# calibrated values from your own enrollment and confirmed labels.
SPEAKER_MATCH_THRESHOLD=0.50
SPEAKER_MATCH_MARGIN=0.10
