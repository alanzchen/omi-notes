# omi-notes backend configuration. Copy to backend/.env (or export the variables).
# Environment variables win over this file. OMI_NOTES_ENV_FILE=/path/to/file selects another file.

# --- Server -------------------------------------------------------------------------------------
# Bearer token the iPhone app sends. `omi-notes pair` generates one here if it is empty.
OMI_NOTES_TOKEN=
# Bind address and port. Keep 127.0.0.1 and expose it with `tailscale serve` (HTTPS, tailnet only).
HOST=127.0.0.1
PORT=8765

# --- Folders ------------------------------------------------------------------------------------
# The product: markdown notes (can live inside an Obsidian vault).
NOTES_DIR=~/Documents/OmiNotes
# Internal state: SQLite ledger, raw uploaded chunks, provider caches, logs.
DATA_DIR=~/.local/share/omi-notes
# IANA timezone used for filenames, daily notes and times in notes (default: this Mac's zone).
# TIMEZONE=America/Chicago
# Your name, so action items you own read "Alan" instead of "me". Optional.
OWNER_NAME=

# --- Speech to text -----------------------------------------------------------------------------
# deepgram | fake (fake = placeholder text, for testing without an account)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
# Spoken language (Deepgram code, e.g. en, de, es; "multi" = auto-detect).
STT_LANGUAGE=en
# Comma-separated names/terms to boost (people, products, places). At most 100 are sent.
STT_KEYTERMS=Omi

# --- Summaries ----------------------------------------------------------------------------------
# anthropic | fake | none (none = transcript-only notes, no LLM)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max: higher is more thorough and costs more.
LLM_EFFORT=medium

# --- Conversation segmentation (seconds) --------------------------------------------------------
# A silence at least this long ends a conversation.
CONVERSATION_GAP_SECONDS=120
# If the audio needed to confirm an ending has not arrived, close anyway (marked provisional)
# this long after the gap: short wait while the phone is connected, longer otherwise.
PROVISIONAL_WAIT_OPEN_SECONDS=300
PROVISIONAL_WAIT_SECONDS=1200
# Long conversations: split at the next 20 s pause after the soft cap, or hard at the hard cap.
SOFT_MAX_CONVERSATION_SECONDS=10800
HARD_MAX_CONVERSATION_SECONDS=11400

# --- Audio --------------------------------------------------------------------------------------
# silero (default; run `omi-notes fetch-models`) | energy (crude fallback)
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
# Uploaded raw audio is deleted this many days after every conversation using it is finished.
RAW_RETENTION_DAYS=30
# How often the worker looks for new work.
WORKER_TICK_SECONDS=5
