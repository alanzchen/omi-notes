// Shared build settings for the OmiNotes app target.
// Personal signing (team + a bundle id you own) goes in Local.xcconfig, which is gitignored.
// Copy Local.xcconfig.example to Local.xcconfig and edit it.

PRODUCT_NAME = OmiNotes
OMI_APP_BUNDLE_ID = dev.omi-notes.app
PRODUCT_BUNDLE_IDENTIFIER = $(OMI_APP_BUNDLE_ID)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
IPHONEOS_DEPLOYMENT_TARGET = 17.0

#include? "Local.xcconfig"
